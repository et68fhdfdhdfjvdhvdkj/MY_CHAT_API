# Runtime
HOST=0.0.0.0
PORT=8000
USE_MOCK_MODE=false

# Required to use the real model
GITHUB_TOKEN=your_github_pat_here
# Optional: use a different model or GitHub Models URL
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# Optional: allow browser access from specific frontend origins
# Separate multiple origins with commas
CORS_ORIGINS=http://localhost:3000,https://your-app.example.com
